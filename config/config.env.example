# Non-secret configuration. The schema and ranges are documented in
# docs/configuration.md; unknown settings are ignored.
# Copy is created at ~/.config/llm-coding/config.env by llm-install.

# Versions are intentionally pinned for reproducibility.
OPENCODE_VERSION=1.18.14

# Binary CUDA variant built into RUNPOD_IMAGE. It must match the runtime image.
VLLM_VERSION=0.28.0
VLLM_CUDA_VERSION=129

# RunPod pod definition.
RUNPOD_POD_NAME=opencode-qwen3-coder
RUNPOD_GPU_TYPE="NVIDIA L40S"
RUNPOD_CLOUD_TYPE=SECURE
# Changes under docker/ publish to GHCR from main. Use the immutable sha- tag
# emitted by the workflow here. Do not use :latest.
RUNPOD_IMAGE=ghcr.io/danieldube/llm-coder-runtime:sha-REPLACE_WITH_COMMIT
# The ID of a RunPod registry credential for a read-only GHCR token. Leave
# empty only when RUNPOD_IMAGE is public. The token itself never goes here.
RUNPOD_CONTAINER_REGISTRY_AUTH_ID=
RUNPOD_CONTAINER_DISK_GB=40
RUNPOD_VOLUME_GB=100
RUNPOD_VOLUME_MOUNT_PATH=/workspace
RUNPOD_MIN_RAM_PER_GPU=48
RUNPOD_MIN_VCPU_PER_GPU=8

# Optional: attach an existing RunPod network volume instead of a pod-local
# persistent volume. Leave empty to use RUNPOD_VOLUME_GB.
RUNPOD_NETWORK_VOLUME_ID=

# Dedicated key used only for this stack.
RUNPOD_SSH_KEY="$HOME/.ssh/runpod_llm_ed25519"

# Model and vLLM configuration.
MODEL_ID=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8
MODEL_REVISION=e8ab3f2db9e388999a004eea5a31c16a8b517bc0
SERVED_MODEL_NAME=qwen3-coder
MODEL_DISPLAY_NAME="Qwen3-Coder 30B A3B FP8"
CONTEXT_SIZE=65536
MAX_OUTPUT_TOKENS=16384
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_TOOL_CALL_PARSER=qwen3_xml
REMOTE_VLLM_PORT=8000

# Host-side ports. 18000 is the stable endpoint OpenCode uses. 18001 is the
# direct SSH-tunnel endpoint used internally and for diagnostics.
LOCAL_PROXY_PORT=18000
LOCAL_TUNNEL_PORT=18001

# systemd-socket-proxyd exits after this period without active connections;
# ExecStopPost then stops the RunPod pod.
IDLE_SHUTDOWN=30min

# Startup timeouts (1-86400 seconds each).
RUNPOD_START_TIMEOUT_SECONDS=1200
VLLM_START_TIMEOUT_SECONDS=1800

# OpenCode / JetBrains integration.
JETBRAINS_AGENT_NAME="OpenCode RunPod"
ENABLE_IDEA_MCP=true
ENABLE_CUSTOM_MCP=false
