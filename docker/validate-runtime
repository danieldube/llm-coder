#!/usr/bin/env python
"""Report and validate the official CUDA 12.9 vLLM runtime contract."""

import sys
from importlib import import_module
from typing import Any

torch: Any = import_module('torch')
vllm: Any = import_module('vllm')


def main() -> None:
    """Print software and optional GPU details without requiring a GPU."""
    if vllm.__version__ != '0.28.0':
        raise RuntimeError(f'Expected vLLM 0.28.0, found {vllm.__version__}')
    if torch.version.cuda is None or not torch.version.cuda.startswith('12.9'):
        raise RuntimeError(
            f'Expected PyTorch CUDA 12.9, found {torch.version.cuda}'
        )

    available = torch.cuda.is_available()
    print(f'python={sys.version.split()[0]}')
    print(f'torch={torch.__version__}')
    print(f'torch_cuda={torch.version.cuda}')
    print(f'vllm={vllm.__version__}')
    print(f'cuda_available={available}')
    if available:
        print(f'gpu={torch.cuda.get_device_name(0)}')
        print(f'capability={torch.cuda.get_device_capability(0)}')


if __name__ == '__main__':
    main()
