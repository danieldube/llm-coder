# The official vLLM image is the authoritative CUDA, PyTorch, and vLLM
# combination. Manifest-list digest verified by the published image build.
FROM vllm/vllm-openai:v0.28.0-cu129-ubuntu2404@sha256:56b291b6179fe5e6e6ad5c509d362e745280ccdbe81ecbc0f5155b1cab0ebfc5

USER root

COPY docker/vllm-python /usr/local/bin/vllm-python

# A custom RunPod Pod image must provide its own SSH daemon. No inference
# dependencies are installed or changed here.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && chmod 0755 /usr/local/bin/vllm-python \
    && /usr/local/bin/vllm-python -c "import torch, vllm; assert torch.__version__.split('+', 1)[0] == '2.13.0'; assert vllm.__version__ == '0.28.0'; assert torch.version.cuda is not None; assert torch.version.cuda.startswith('12.9')" \
    && if pip_errors="$(/usr/local/bin/vllm-python -m pip check 2>&1)"; then \
        :; \
    elif [ "$pip_errors" = 'torch 2.13.0+cu129 has requirement nvidia-nccl-cu12==2.29.7; platform_system == "Linux", but you have nvidia-nccl-cu12 2.30.7.' ]; then \
        echo 'Reviewed upstream NCCL metadata mismatch.' >&2; \
    else \
        echo "$pip_errors" >&2; exit 1; \
    fi

COPY docker/container-start.sh /usr/local/bin/container-start
COPY docker/start-vllm.cuda129.sh /opt/llm-coding/bin/start-vllm.sh
COPY docker/validate-runtime /usr/local/bin/validate-runtime

RUN chmod 0755 \
    /usr/local/bin/container-start \
    /usr/local/bin/vllm-python \
    /opt/llm-coding/bin/start-vllm.sh \
    /usr/local/bin/validate-runtime

# The upstream image's entrypoint is ["vllm", "serve"]. This image must wait
# for the controller to invoke start-vllm over SSH.
ENTRYPOINT ["/usr/local/bin/container-start"]
CMD []
