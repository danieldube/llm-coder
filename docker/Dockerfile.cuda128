# CUDA 12.8 is the compatibility baseline for Blackwell and RunPod's
# 570-series drivers. Keep the base image's SSH entrypoint and command: the
# controller relies on its SSH_PUBLIC_KEY startup integration.
FROM runpod/pytorch:1.3.1-cu1281-torch2130-ubuntu2404@sha256:8ee5a5d7c421cedb3fc3a9550f1360cf385af3986d9fd60ca14b0c25ec7cc5a3

ARG VLLM_VERSION=0.28.0
ARG VLLM_SOURCE_REVISION=2cf0a69
ARG TARGETARCH

ENV VLLM_PYTHON=/usr/local/bin/python

# vLLM 0.28.0 publishes CUDA 12.9 and 13.0 wheels only. Build the reviewed
# release revision against the base image's CUDA 12.8 PyTorch installation;
# dependencies remain in the image and are never installed on a live Pod.
RUN case "${TARGETARCH:-amd64}" in \
        amd64) ;; \
        *) echo "CUDA 12.8 runtime supports only linux/amd64" >&2; exit 1 ;; \
    esac \
    && "${VLLM_PYTHON}" -c \
        "import torch; assert torch.__version__.split('+', 1)[0] == '2.13.0'" \
    && uv pip install --system --break-system-packages --no-build-isolation \
        "git+https://github.com/vllm-project/vllm.git@${VLLM_SOURCE_REVISION}" \
    && "${VLLM_PYTHON}" -c \
        "import torch, vllm; assert torch.version.cuda.startswith('12.8'); assert vllm.__version__ == '${VLLM_VERSION}'"

COPY start-vllm.sh /opt/llm-coding/bin/start-vllm.sh
RUN chmod 0755 /opt/llm-coding/bin/start-vllm.sh
