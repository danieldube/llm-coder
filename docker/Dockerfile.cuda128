# CUDA 12.8 fallback runtime. Native vLLM compilation belongs exclusively in
# Dockerfile.cuda128-wheel, which publishes a verified release artifact.
FROM runpod/pytorch:1.3.1-cu1281-torch2130-ubuntu2404@sha256:8ee5a5d7c421cedb3fc3a9550f1360cf385af3986d9fd60ca14b0c25ec7cc5a3

ARG TARGETARCH
ENV VLLM_PYTHON=/usr/local/bin/python

COPY docker/vllm-cu128-wheel/ /opt/llm-coding/wheel/
COPY docker/start-vllm.sh /opt/llm-coding/bin/start-vllm.sh
COPY docker/validate-runtime.cuda128 /usr/local/bin/validate-runtime
COPY docker/verify-vllm-cu128-wheel.py /usr/local/bin/verify-vllm-cu128-wheel

RUN <<'EOF'
set -eu
case "${TARGETARCH:-amd64}" in
    amd64) ;;
    *) echo "CUDA 12.8 runtime supports only linux/amd64" >&2; exit 1 ;;
esac
"${VLLM_PYTHON}" - <<'PY'
import torch

assert torch.__version__.split('+', 1)[0] == '2.13.0'
assert torch.version.cuda is not None
assert torch.version.cuda.startswith('12.8')
PY
wheel_count="$(find /opt/llm-coding/wheel -maxdepth 1 -name '*.whl' -type f | wc -l)"
test "$wheel_count" = 1
test -f /opt/llm-coding/wheel/vllm-cu128-wheel-manifest.json
wheel="$("${VLLM_PYTHON}" /usr/local/bin/verify-vllm-cu128-wheel \
    /opt/llm-coding/wheel)"
wheel="/opt/llm-coding/wheel/${wheel}"
"${VLLM_PYTHON}" -m pip install --break-system-packages "$wheel"
chmod 0755 /usr/local/bin/validate-runtime /opt/llm-coding/bin/start-vllm.sh
/usr/local/bin/validate-runtime
rm -rf /opt/llm-coding/wheel
EOF
