#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

require_command curl
require_command jq
require_command systemctl
require_command journalctl

response_file="$(mktemp)"
error_file="$(mktemp)"

cleanup() {
    rm -f "${response_file}" "${error_file}"
}

trap cleanup EXIT

echo "Activating the LLM runtime..." >&2
initial_invocation="$(
    systemctl --user show --property=InvocationID --value llm-coding-proxy.service 2>/dev/null \
        || true
)"

curl \
    --fail \
    --silent \
    --show-error \
    --max-time "$((RUNPOD_START_TIMEOUT_SECONDS + VLLM_START_TIMEOUT_SECONDS + 120))" \
    "http://127.0.0.1:${LOCAL_PROXY_PORT}/v1/models" \
    >"${response_file}" \
    2>"${error_file}" &

curl_pid=$!
proxy_invocation=""
activation_observed=false

while kill -0 "${curl_pid}" 2>/dev/null; do
    mapfile -t proxy_state < <(
        systemctl --user show \
            --property=ActiveState \
            --property=InvocationID \
            --value \
            llm-coding-proxy.service
    )
    active_state="${proxy_state[0]:-}"
    current_invocation="${proxy_state[1]:-}"

    # Ignore the unit's prior invocation: it may be a stale failed service
    # when the socket request arrives. Only treat a failure or replacement as
    # relevant after observing the new invocation this request activated.
    if [[ "${activation_observed}" == false ]] \
        && [[ "${active_state}" == "activating" || "${active_state}" == "active" ]] \
        && [[ -n "${current_invocation}" ]] \
        && [[ "${current_invocation}" != "${initial_invocation}" ]]; then
        proxy_invocation="${current_invocation}"
        activation_observed=true
    fi

    if { [[ "${activation_observed}" == true ]] && [[ "${active_state}" == "failed" ]]; } \
        || { [[ "${activation_observed}" == true ]] \
            && [[ -n "${current_invocation}" ]] \
            && [[ "${current_invocation}" != "${proxy_invocation}" ]]; }; then
        kill "${curl_pid}" 2>/dev/null || true
        wait "${curl_pid}" 2>/dev/null || true

        echo >&2
        echo "LLM runtime activation failed." >&2
        echo >&2
        echo "Recent llm-coding-proxy.service log:" >&2
        echo >&2
        journalctl --user --unit llm-coding-proxy.service --lines 100 --no-pager >&2
        exit 1
    fi

    sleep 1
done

if ! wait "${curl_pid}"; then
    cat "${error_file}" >&2
    exit 1
fi

jq . "${response_file}"
