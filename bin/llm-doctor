#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

activate=false
if [[ "${1:-}" == "--activate" ]]; then
    activate=true
elif [[ $# -gt 0 ]]; then
    echo "Usage: llm-doctor [--activate]" >&2
    exit 2
fi

ok() { printf '[OK]   %s\n' "$1"; }
fail() { printf '[FAIL] %s\n' "$1" >&2; exit 1; }

for cmd in bash curl jq ssh ssh-keygen flock systemctl; do
    command -v "${cmd}" >/dev/null 2>&1 || fail "Missing command: ${cmd}"
done
ok "Host dependencies"

[[ -f "${CONFIG_FILE}" ]] || fail "Missing ${CONFIG_FILE}"
[[ -f "${SECRETS_FILE}" ]] || fail "Missing ${SECRETS_FILE}"
ok "Configuration files"

printf 'vLLM version:        %s\n' "${VLLM_VERSION}"
printf 'vLLM CUDA variant:   cu%s\n' "${VLLM_CUDA_VERSION}"
printf 'RunPod image:        %s\n' "${RUNPOD_IMAGE}"

[[ -n "${RUNPOD_API_KEY:-}" && "${RUNPOD_API_KEY}" != "REPLACE_ME" ]] || fail "RUNPOD_API_KEY is not configured"
ok "RunPod API key configured"

[[ -r "${RUNPOD_SSH_KEY}" && -r "${RUNPOD_SSH_KEY}.pub" ]] || fail "Dedicated RunPod SSH key is missing"
ok "RunPod SSH key"

opencode_bin="${HOME}/.opencode/bin/opencode"
[[ -x "${opencode_bin}" ]] || fail "OpenCode is not installed"
installed_version="$(${opencode_bin} --version 2>/dev/null | tr -d '[:space:]')"
[[ "${installed_version}" == "${OPENCODE_VERSION}" ]] || fail "OpenCode version ${installed_version}; expected ${OPENCODE_VERSION}"
ok "OpenCode ${OPENCODE_VERSION}"

systemctl --user is-enabled llm-coding.socket >/dev/null 2>&1 || fail "llm-coding.socket is not enabled"
systemctl --user is-active llm-coding.socket >/dev/null 2>&1 || fail "llm-coding.socket is not listening"
ok "systemd socket activation"

acp_file="${HOME}/.jetbrains/acp.json"
[[ -f "${acp_file}" ]] || fail "JetBrains ACP configuration not found"
jq -e --arg name "${JETBRAINS_AGENT_NAME}" '.agent_servers[$name]' "${acp_file}" >/dev/null || fail "JetBrains ACP agent is not registered"
ok "JetBrains ACP registration"

if ! ${activate}; then
    echo "Use 'llm-doctor --activate' for an end-to-end RunPod/vLLM/tool-calling test."
    exit 0
fi

"${SCRIPT_DIR}/llm-up" >/dev/null
ok "RunPod/vLLM activation"

endpoint="http://127.0.0.1:${LOCAL_PROXY_PORT}/v1"
models="$(curl --fail --silent "${endpoint}/models")"
jq -e --arg model "${SERVED_MODEL_NAME}" '.data[]? | select(.id == $model)' <<<"${models}" >/dev/null || fail "Expected model is not served"
ok "Expected model ${SERVED_MODEL_NAME}"

completion_body="$(jq -n --arg model "${SERVED_MODEL_NAME}" '{model:$model,max_tokens:32,messages:[{role:"user",content:"Reply with exactly: OK"}]}')"
completion="$(curl --fail --silent -H 'Content-Type: application/json' -d "${completion_body}" "${endpoint}/chat/completions")"
jq -e '.choices[0].message.content | strings | length > 0' <<<"${completion}" >/dev/null || fail "Chat completion failed"
ok "Chat completion"

tool_body="$(jq -n --arg model "${SERVED_MODEL_NAME}" '{
  model:$model,
  max_tokens:64,
  messages:[{role:"user",content:"Call get_temperature for Berlin. Use the tool; do not answer directly."}],
  tools:[{type:"function",function:{name:"get_temperature",description:"Get the temperature for a city",parameters:{type:"object",properties:{city:{type:"string"}},required:["city"]}}}]
}')"
tool_response="$(curl --fail --silent -H 'Content-Type: application/json' -d "${tool_body}" "${endpoint}/chat/completions")"
jq -e '.choices[0].message.tool_calls | arrays | length > 0' <<<"${tool_response}" >/dev/null || fail "Tool calling test failed"
ok "Native tool calling"
