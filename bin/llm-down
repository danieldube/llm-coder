#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Stopping the proxy invokes ExecStopPost=runtime-down.sh if it is active.
systemctl --user stop llm-coding-proxy.service >/dev/null 2>&1 || true

# Also call it directly so manual shutdown works if the proxy was already idle.
exec "${SCRIPT_DIR}/runtime-down.sh"
